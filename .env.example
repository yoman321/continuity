# Copy to .env and fill in. Never commit .env.

# --- Parallel (partner track, required at runtime) ---
# Get a key at https://parallel.ai — free tier is ~16k requests.
PARALLEL_API_KEY=

# --- Gemini via the Enterprise Agent Platform ---
# No API key. Auth is Application Default Credentials:
#   local:    gcloud auth application-default login
#   deployed: the Cloud Run service account, via the metadata server
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# --- MediaWiki (own instance; never the real Fandom wiki) ---
# All of these are generated by scripts/setup_wiki.sh; you should not have to fill them in by
# hand. Secret Manager when deployed. The DB and admin values are only used by that script and
# by MediaWiki's own maintenance commands — the agent uses the API URL and the bot password.
MEDIAWIKI_API_URL=
# The wiki is treated as external even though it is ours: the agent gets no privileged path to
# it, so reads and writes both carry this in an `X-API-Key` header and refuse to run without
# it. Any random string locally (`openssl rand -hex 24`); Secret Manager when deployed.
# MediaWiki does not validate it today — the gate is ours — so it is a dummy standing exactly
# where a real credential goes.
MEDIAWIKI_API_KEY=
MEDIAWIKI_DB_NAME=
MEDIAWIKI_DB_USER=
MEDIAWIKI_DB_PASSWORD=
MEDIAWIKI_ADMIN_USER=
MEDIAWIKI_ADMIN_PASSWORD=
MEDIAWIKI_API_KEY=
# `User@appid` plus its 32-character secret, from createBotPassword.php. Main-account API
# login is deprecated and refused, so a BotPassword is the only way in.
MEDIAWIKI_BOT_USER=
MEDIAWIKI_BOT_PASSWORD=

# --- Document store ---
# Where a run's documents live: `file` (default, under data/) or `firestore`. Both hold the
# identical documents, so this is a deployment choice and not a code path. Firestore needs
# `google-cloud-firestore` installed and GOOGLE_CLOUD_PROJECT set.
# One switch for every store a run writes — drafts and judgements — because a run that put half
# its documents in a file and half in Firestore would have written half its provenance
# somewhere nothing reads. The name predates the second store.
# DRAFT_STORE_PATH overrides the drafts file's location; unset is data/drafts.json.
DRAFT_STORE=file

# --- Scheduler ---
# Shared secret for POST /internal/tick. Judging requires the service be public, so this
# header is the only thing between a guessed path and unbounded agent runs. Any random string
# locally (`openssl rand -hex 24`); Secret Manager when deployed. Empty means the tick refuses
# to run at all, which is the safe default.
TICK_TOKEN=
