# Copy to .env and fill in. Never commit .env.

# --- Parallel (partner track, required at runtime) ---
# Get a key at https://parallel.ai — free tier is ~16k requests.
PARALLEL_API_KEY=

# --- Gemini via the Enterprise Agent Platform ---
# No API key. Auth is Application Default Credentials:
#   local:    gcloud auth application-default login
#   deployed: the Cloud Run service account, via the metadata server
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# --- MediaWiki (own instance; never the real Fandom wiki) ---
# Created at Special:BotPasswords once the wiki is up. Secret Manager when deployed.
MEDIAWIKI_API_URL=
MEDIAWIKI_BOT_USER=
MEDIAWIKI_BOT_PASSWORD=
