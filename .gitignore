# Secrets — never commit. The submission repo is public.
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
credentials*.json
application_default_credentials.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# The local MediaWiki install. Third-party GPL software, ~50MB, reproducible from
# scripts/setup_wiki.sh — so it is a build artifact here, not source. Also keeps it out of
# Cloud Build, since .gcloudignore includes this file.
# Leading slash is load-bearing: bare `wiki/` matches ANY directory named wiki at any depth,
# which silently swallowed backend/core/wiki/snapshots.py. Anchor anything that names a
# directory the codebase also uses as a package.
/wiki/

# Recorded search cassettes. Third-party web excerpts, so they stay out of a public MIT
# repo (`CLAUDE.md` §6) — a fresh clone runs live or records its own. Anchored, as above.
/fixtures/

# ADK / agent local state
.adk/
*.sqlite
*.sqlite3
*.db

# The local claim ledger (`backend/core/ledger/store.py`). Run state, not source: it is what
# a run writes back, and committing it would ship one machine's schedule to every other.
/data/

# Node — the FE is vanilla and has no build step (AGENTS.md §5); node only runs FE/check.js.
# These stay as a guard: if a toolchain ever creeps in, its output must not be committed.
node_modules/
dist/
build/
.next/

# OS / editor
.DS_Store
.idea/
*.swp

# Claude Code local overrides
.claude/settings.local.json

# mongod's own data directory — a database, not source.
/data/mongo/
